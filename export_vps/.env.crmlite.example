# ─────────────────────────────────────────────────────────────
# .env.crmlite — configuração do worker TSE para o projeto CRM Lite
#
# COMO USAR:
#   1. Copie este arquivo para `.env.crmlite` (mesma pasta).
#   2. Preencha SUPABASE_SERVICE_KEY com a service_role key do projeto
#      CRM Lite (Supabase → Project Settings → API → service_role).
#      ⚠️ A service_role IGNORA RLS — nunca commite nem exponha esse valor.
#   3. Rode:  python crmlite_main.py --producao
#      (ou use o run_crmlite.bat)
#
# O wrapper (crmlite_main.py) carrega ESTE arquivo por padrão.
# Para usar outro arquivo:  set WORKER_ENV=.env.outro
# ─────────────────────────────────────────────────────────────

# ── Supabase (CRM Lite) ──
SUPABASE_URL=https://gprahiwcxvqorpuielju.supabase.co
SUPABASE_SERVICE_KEY=

# ── Notificações (opcional — webhook Discord/Slack) ──
# Recebe avisos de captcha pendente, fila zerada, produção travada.
NOTIFY_WEBHOOK_URL=

# ── APIs de enriquecimento (fase A: descobre nome_mae/data a partir do CPF) ──
# Sem essas chaves a fase A simplesmente não encontra nada (a fase B roda
# normal com o que já estiver preenchido em `people`).
# API B (principal) e Hashiro (fallback 1) estão LIGADAS em settings.py;
# DataSintese (fallback 2) está DESLIGADA por padrão.
API_B_KEY=
HASHIRO_TOKEN=
DATASINTESE_USER=
DATASINTESE_PASS=

# ── ADB/Chrome (legado do config.py — NÃO é usado pelo clicker AHK) ──
# Só preencha se for usar os modos antigos baseados em celular.
# ANDROID_CHROME_PACKAGE=com.android.chrome
# ADB_DEVICE_SERIAL=
# ADB_PATH=adb
# CHROMEDRIVER_PATH=
