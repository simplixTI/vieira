# Copie para .env e preencha. (.env NÃO deve ir pro git.)

# ── Supabase (OBRIGATÓRIO) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Enriquecimento (opcional — só se usar --enriquecer) ──
# Principal: API B
API_B_KEY=
# Fallback 1: Hashiro
HASHIRO_TOKEN=
# Fallback 2: DataSintese
DATASINTESE_USER=
DATASINTESE_PASS=

# ── Notificação (opcional) ──
# Webhook de Discord ou Slack. Se preenchido, o script avisa quando:
#   - aparece captcha pra resolver (você tem 30s!)
#   - a fila ZERA ou a produção para sem progresso
NOTIFY_WEBHOOK_URL=
